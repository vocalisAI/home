+.voice-piece:focus { z-index: 3; }
+.voice-piece[data-dragging] { z-index: 4; cursor: grabbing; box-shadow: 0 12px 25px rgba(30,43,69,.15); }
+.voice-playground__wordmark { flex: none; font-size: clamp(80px,15.5vw,215px); font-weight: 600; letter-spacing: -.075em; line-height: .9; margin: 0 0 22px -0.06em; pointer-events: none; }
+@media (max-width: 719px) {
+  .playground-reserve { height: 470px; }
