+import React, { useEffect, useRef } from "react";
+import { useReducedMotion } from "../../lib/hooks";
+
+const PIECES = [
+  { id: "voice", label: "Voice", kind: "voice", x: 0.08, y: 0.18 },
+  { id: "hello", label: "Hello.", kind: "hello", x: 0.36, y: 0.04 },
+  { id: "call", label: "Always here", kind: "call", x: 0.64, y: 0.48 },
+  { id: "calendar", label: "Booked", kind: "calendar", x: 0.88, y: 0.12 },
+];
+
+function PieceArt({ kind }) {
+  if (kind === "hello") return <span className="voice-piece__hello">Hello.</span>;
+  if (kind === "voice") return <svg viewBox="0 0 100 80" fill="none" aria-hidden="true"><path d="M7 40h12l7-15 10 33 12-48 12 59 12-42 8 13h13" stroke="currentColor" strokeWidth="5" strokeLinecap="round" strokeLinejoin="round" /></svg>;
+  if (kind === "call") return <svg viewBox="0 0 80 80" fill="none" aria-hidden="true"><path d="M20 13l13 14-8 9c6 10 11 15 21 20l8-9 14 12c-3 12-11 13-18 10C28 60 15 47 11 28c-1-7 1-12 9-15Z" stroke="currentColor" strokeWidth="4" strokeLinejoin="round" /></svg>;
+  return <svg viewBox="0 0 80 80" fill="none" aria-hidden="true"><rect x="12" y="18" width="56" height="52" rx="10" stroke="currentColor" strokeWidth="4" /><path d="M12 33h56M26 11v15M54 11v15M27 49l9 9 18-18" stroke="currentColor" strokeWidth="4" strokeLinecap="round" strokeLinejoin="round" /></svg>;
+}
+
+/** A bounded toy, never navigation. Motion runs only while a visible piece is moving. */
+export default function VoicePlayground() {
+  const stageRef = useRef(null);
+  const elements = useRef([]);
+  const api = useRef({});
+  const reduced = useReducedMotion();
+
+  useEffect(() => {
+    const stage = stageRef.current;
+    const nodes = elements.current;
+    let frame = 0;
+    let lastFrame = 0;
+    let visible = false;
+    let drag = null;
+    let suppressClick = null;
+    let bounds = { width: 0, height: 0 };
+    const positions = PIECES.map(() => ({ x: 0, y: 0, vx: 0, vy: 0, w: 0, h: 0 }));
+    const clamp = (n, min, max) => Math.max(min, Math.min(n, Math.max(min, max)));
+    const keepInside = (p) => {
+      p.x = clamp(p.x, 8, bounds.width - p.w - 8);
+      p.y = clamp(p.y, 8, bounds.height - p.h - 8);
+    };
+    const paint = (i) => {
+      const p = positions[i];
+      nodes[i].style.transform = `translate3d(${p.x}px, ${p.y}px, 0)`;
+    };
+    const stop = () => { cancelAnimationFrame(frame); frame = 0; lastFrame = 0; };
+    const reset = () => {
+      stop(); drag = null;
+      bounds = { width: stage.clientWidth, height: stage.clientHeight };
+      nodes.forEach((node, i) => {
+        node.removeAttribute("data-dragging");
+        const p = positions[i];
+        p.w = node.offsetWidth; p.h = node.offsetHeight;
+        p.x = 8 + (bounds.width - p.w - 16) * PIECES[i].x;
+        p.y = 8 + (bounds.height - p.h - 16) * PIECES[i].y;
+        p.vx = 0; p.vy = 0; keepInside(p); paint(i);
+      });
+    };
+    const tick = (time) => {
+      frame = 0;
+      if (!visible || document.hidden || reduced) return;
+      const dt = lastFrame ? Math.min((time - lastFrame) / 16.67, 2) : 1;
+      lastFrame = time;
+      let moving = false;
+      positions.forEach((p, i) => {
+        if (drag?.i === i) return;
+        p.x += p.vx * dt; p.y += p.vy * dt;
+        if (p.x < 8 || p.x > bounds.width - p.w - 8) p.vx *= -0.55;
+        if (p.y < 8 || p.y > bounds.height - p.h - 8) p.vy *= -0.55;
+        keepInside(p);
+        p.vx *= Math.pow(0.94, dt); p.vy *= Math.pow(0.94, dt);
+        if (Math.abs(p.vx) + Math.abs(p.vy) < 0.12) { p.vx = 0; p.vy = 0; }
+        else moving = true;
+        paint(i);
+      });
+      if (moving) frame = requestAnimationFrame(tick);
+      else lastFrame = 0;
+    };
+    const animate = () => {
+      if (!frame && visible && !document.hidden && !reduced) frame = requestAnimationFrame(tick);
+    };
+    const down = (e, i) => {
+      if (!e.isPrimary || e.button !== 0 || drag) return;
+      const p = positions[i];
+      suppressClick = null;
+      p.vx = 0; p.vy = 0;
+      drag = { i, pointerId: e.pointerId, startX: e.clientX, startY: e.clientY, x: e.clientX, y: e.clientY, time: e.timeStamp, distance: 0 };
+      e.currentTarget.setPointerCapture(e.pointerId);
+      e.currentTarget.setAttribute("data-dragging", "true");
+    };
+    const move = (e, i) => {
+      if (!drag || drag.i !== i || drag.pointerId !== e.pointerId) return;
+      const p = positions[i];
+      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
+      const dt = Math.max(8, e.timeStamp - drag.time);
+      p.x += dx; p.y += dy;
+      p.vx = clamp(dx / dt * 16.67, -14, 14); p.vy = clamp(dy / dt * 16.67, -14, 14);
+      drag.x = e.clientX; drag.y = e.clientY; drag.time = e.timeStamp;
+      drag.distance = Math.hypot(e.clientX - drag.startX, e.clientY - drag.startY);
+      keepInside(p); paint(i);
+    };
+    const end = (e, i, cancelled = false) => {
+      if (!drag || drag.i !== i || drag.pointerId !== e.pointerId) return;
+      const p = positions[i];
+      if (cancelled || reduced || e.timeStamp - drag.time > 100) { p.vx = 0; p.vy = 0; }
+      if (drag.distance > 5 || cancelled) suppressClick = i;
+      drag = null;
+      e.currentTarget.removeAttribute("data-dragging");
+      if (e.currentTarget.hasPointerCapture(e.pointerId)) e.currentTarget.releasePointerCapture(e.pointerId);
+      animate();
+    };
+    const nudge = (i) => {
+      if (suppressClick === i) { suppressClick = null; return; }
+      const p = positions[i];
+      const direction = p.x + p.w / 2 < bounds.width / 2 ? 1 : -1;
+      p.x += direction * 24; p.y += p.y > bounds.height / 2 ? -12 : 12;
+      keepInside(p); paint(i);
+      if (!reduced) { p.vx = direction * 4; p.vy = -2; animate(); }
+    };
+    const key = (e, i) => {
+      const moves = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
+      if (e.key === "Home") { e.preventDefault(); reset(); return; }
+      if (!moves[e.key]) return;
+      e.preventDefault();
+      const p = positions[i], amount = e.shiftKey ? 40 : 16;
+      p.vx = 0; p.vy = 0;
+      p.x += moves[e.key][0] * amount; p.y += moves[e.key][1] * amount;
+      keepInside(p); paint(i);
+    };
+    api.current = { down, move, end, nudge, key, reset };
+    reset();
+    const resize = new ResizeObserver(reset); resize.observe(stage);
+    const observer = new IntersectionObserver(([entry]) => {
+      visible = entry.isIntersecting;
+      if (!visible) stop(); else animate();
+    });
+    observer.observe(stage);
+    const onVisibility = () => { if (document.hidden) stop(); else animate(); };
+    document.addEventListener("visibilitychange", onVisibility);
+    return () => { stop(); resize.disconnect(); observer.disconnect(); document.removeEventListener("visibilitychange", onVisibility); api.current = {}; };
+  }, [reduced]);
+
+  return <section className="voice-playground" aria-labelledby="playground-title">
+    <div className="container">
+      <div className="voice-playground__heading">
+        <div><h2 id="playground-title">Go on. Give us a nudge.</h2><p id="playground-help">Drag a piece, or tap to move it. Keyboard: arrow keys move; Home resets.</p></div>
+        <button className="btn btn--ghost btn--sm" type="button" onClick={() => api.current.reset?.()}>Reset pieces</button>
+      </div>
+      <div className="voice-playground__stage" ref={stageRef}>
+        {PIECES.map((piece, i) => <button key={piece.id} type="button" ref={(el) => { elements.current[i] = el; }}
+          className={`voice-piece voice-piece--${piece.kind}`} aria-label={`Move ${piece.label} piece`} aria-describedby="playground-help"
+          onPointerDown={(e) => api.current.down?.(e, i)} onPointerMove={(e) => api.current.move?.(e, i)}
+          onPointerUp={(e) => api.current.end?.(e, i)} onPointerCancel={(e) => api.current.end?.(e, i, true)}
+          onLostPointerCapture={(e) => api.current.end?.(e, i, true)} onClick={() => api.current.nudge?.(i)} onKeyDown={(e) => api.current.key?.(e, i)}>
+          <PieceArt kind={piece.kind} />{piece.kind !== "hello" && <span>{piece.label}</span>}
+        </button>)}
+      </div>
+      <div className="voice-playground__wordmark" aria-hidden="true">vocalis</div>
+    </div>
+  </section>;
+}
